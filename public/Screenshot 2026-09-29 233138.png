<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1203 753" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="warmBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F8F9FA"/>
      <stop offset="100%" stop-color="#F3F4F6"/>
    </linearGradient>

    <!-- Purple Button Gradient -->
    <linearGradient id="purpleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C3AED"/>
      <stop offset="100%" stop-color="#6D28D9"/>
    </linearGradient>

    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#0F172A" flood-opacity="0.06"/>
    </filter>

    <filter id="cardShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#0F172A" flood-opacity="0.08"/>
    </filter>
  </defs>

  <style>
    .font-sans { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', 'Fira Code', 'Source Code Pro', monospace; }
  </style>

  <!-- Clean Canvas Background -->
  <rect width="1203" height="753" fill="url(#warmBg)"/>

  <!-- TOP FLOATING NAVBAR -->
  <g transform="translate(48, 24)">
    <rect x="0" y="0" width="1107" height="58" rx="16" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.2" filter="url(#softShadow)"/>
    
    <!-- Left: Brand Logo & Title -->
    <g transform="translate(20, 11)">
      <!-- Purple Rounded Square Icon -->
      <rect x="0" y="0" width="36" height="36" rx="9" fill="url(#purpleGrad)"/>
      <!-- Stylized Chair / Atelier Outline in White -->
      <path d="M 12 14 Q 12 10 18 10 Q 24 10 24 14 L 24 22 L 12 22 Z M 10 22 L 26 22 M 13 22 L 11 27 M 23 22 L 25 27" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      
      <text x="46" y="21" class="font-sans" font-size="17" font-weight="800" fill="#111827">UrbanLedger</text>
      <text x="46" y="32" class="font-mono" font-size="8.5" font-weight="700" fill="#6B7280" letter-spacing="1">ACCOUNTING ATELIER</text>
    </g>

    <!-- Center Navigation Links -->
    <g transform="translate(320, 22)">
      <text x="0" y="14" class="font-sans" font-size="12.5" font-weight="600" fill="#374151">Workshops &amp; Showrooms</text>
      <text x="175" y="14" class="font-sans" font-size="12.5" font-weight="500" fill="#4B5563">Ledger &amp; Tax</text>
      <text x="280" y="14" class="font-sans" font-size="12.5" font-weight="500" fill="#4B5563">Pricing</text>
      <text x="350" y="14" class="font-sans" font-size="12.5" font-weight="500" fill="#4B5563">Customer Portal</text>
    </g>

    <!-- Right Actions -->
    <g transform="translate(860, 11)">
      <text x="60" y="23" class="font-sans" font-size="13" font-weight="600" fill="#111827" text-anchor="end">Client Log In</text>
      
      <g transform="translate(85, 0)">
        <rect x="0" y="0" width="142" height="36" rx="10" fill="url(#purpleGrad)"/>
        <text x="62" y="23" class="font-sans" font-size="12.5" font-weight="700" fill="#FFFFFF" text-anchor="middle">Start Free Trial →</text>
      </g>
    </g>
  </g>

  <!-- MAIN TWO-COLUMN CONTENT AREA -->
  <!-- LEFT COLUMN: HERO TEXT & ACTIONS -->
  <g transform="translate(48, 128)">
    <!-- Pill Tag -->
    <rect x="0" y="0" width="370" height="26" rx="13" fill="#F3E8FF" stroke="#E9D5FF" stroke-width="1"/>
    <circle cx="14" cy="13" r="3.5" fill="#7C3AED"/>
    <text x="26" y="17" class="font-mono" font-size="9" font-weight="700" fill="#7C3AED" letter-spacing="0.5">TAILORED FOR FURNITURE MANUFACTURERS &amp; RETAIL SHOWROOMS</text>

    <!-- Main Headline -->
    <text x="0" y="68" class="font-sans" font-size="34" font-weight="900" fill="#111827" letter-spacing="-0.8">Precision Accounting Crafted for</text>
    <text x="0" y="112" class="font-sans" font-size="34" font-weight="900" fill="#111827" letter-spacing="-0.8">Furniture Makers, Showrooms &amp;</text>
    <text x="0" y="156" class="font-sans" font-size="34" font-weight="900" fill="#111827" letter-spacing="-0.8">Interior Ateliers</text>

    <!-- Body Paragraph -->
    <text x="0" y="202" class="font-sans" font-size="14" fill="#4B5563" line-height="1.5">Stop juggling spreadsheets and disconnected tools. Track raw lumber</text>
    <text x="0" y="224" class="font-sans" font-size="14" fill="#4B5563">batch costs, upholstery purchase orders, milestone client invoices, and</text>
    <text x="0" y="246" class="font-sans" font-size="14" fill="#4B5563">double-entry general ledger in one warm, tactile workspace.</text>

    <!-- Action Buttons -->
    <g transform="translate(0, 280)">
      <!-- Primary Purple Button -->
      <rect x="0" y="0" width="186" height="46" rx="12" fill="url(#purpleGrad)"/>
      <text x="93" y="28" class="font-sans" font-size="13" font-weight="700" fill="#FFFFFF" text-anchor="middle">Start 14-Day Free Trial ↗</text>

      <!-- Secondary Demo Button -->
      <g transform="translate(202, 0)">
        <rect x="0" y="0" width="186" height="46" rx="12" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.2"/>
        <g transform="translate(24, 15)">
          <rect x="0" y="0" width="16" height="15" rx="3" fill="none" stroke="#7C3AED" stroke-width="1.5"/>
          <line x1="4" y1="0" x2="4" y2="3" stroke="#7C3AED" stroke-width="1.5"/>
          <line x1="12" y1="0" x2="12" y2="3" stroke="#7C3AED" stroke-width="1.5"/>
          <line x1="0" y1="5" x2="16" y2="5" stroke="#7C3AED" stroke-width="1.5"/>
        </g>
        <text x="105" y="28" class="font-sans" font-size="13" font-weight="700" fill="#111827" text-anchor="middle">Book Showroom Demo</text>
      </g>
    </g>

    <!-- Trust Checkmarks -->
    <g transform="translate(0, 356)">
      <text x="0" y="14" class="font-mono" font-size="11" fill="#6B7280">
        <tspan fill="#7C3AED" font-weight="700">✓</tspan> No credit card required  •  <tspan fill="#7C3AED" font-weight="700">✓</tspan> SOC2 Certified  •  <tspan fill="#7C3AED" font-weight="700">✓</tspan> Instant QuickBooks &amp; Xero Sync
      </text>
    </g>
  </g>

  <!-- RIGHT COLUMN: ATELIER LEDGER & ARTISAN ORDERS CARD -->
  <g transform="translate(565, 120)">
    <rect x="0" y="0" width="590" height="468" rx="20" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1.2" filter="url(#cardShadow)"/>
    
    <!-- Card Header -->
    <g transform="translate(24, 24)">
      <!-- Lavender Icon Square -->
      <rect x="0" y="0" width="38" height="38" rx="10" fill="#F3E8FF"/>
      <path d="M 12 26 L 16 20 L 22 24 L 27 14" stroke="#7C3AED" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <circle cx="27" cy="14" r="2" fill="#7C3AED"/>

      <!-- Header Title & Sync Subtext -->
      <text x="50" y="19" class="font-sans" font-size="15" font-weight="700" fill="#111827">Atelier Ledger &amp; Real-Time Valuation</text>
      <circle cx="53" cy="30" r="3" fill="#10B981"/>
      <text x="62" y="33" class="font-mono" font-size="10" fill="#6B7280">Live sync • Kiln Batch #1094 in Production</text>

      <!-- Right Header Pills -->
      <g transform="translate(425, 6)">
        <rect x="0" y="0" width="54" height="22" rx="6" fill="#F3F4F6"/>
        <text x="27" y="15" class="font-mono" font-size="9" font-weight="600" fill="#4B5563" text-anchor="middle">Q3 Fiscal</text>

        <rect x="60" y="0" width="55" height="22" rx="6" fill="#EDE9FE"/>
        <text x="87" y="15" class="font-mono" font-size="9" font-weight="600" fill="#7C3AED" text-anchor="middle">API Online</text>
      </g>
    </g>

    <!-- 3 Metric Cards Row -->
    <g transform="translate(24, 82)">
      <!-- Metric 1: Operating Cash -->
      <rect x="0" y="0" width="170" height="92" rx="12" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
      <text x="14" y="24" class="font-mono" font-size="10" font-weight="600" fill="#6B7280">Operating Cash</text>
      <text x="14" y="52" class="font-sans" font-size="19" font-weight="800" fill="#111827">$342,850.00</text>
      <text x="14" y="74" class="font-mono" font-size="9.5" font-weight="700" fill="#10B981">+14.2% (3 accounts)</text>

      <!-- Metric 2: Milestone AR -->
      <g transform="translate(182, 0)">
        <rect x="0" y="0" width="170" height="92" rx="12" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
        <text x="14" y="24" class="font-mono" font-size="10" font-weight="600" fill="#6B7280">Milestone AR</text>
        <text x="14" y="52" class="font-sans" font-size="19" font-weight="800" fill="#111827">$48,200.00</text>
        <text x="14" y="74" class="font-mono" font-size="9.5" font-weight="700" fill="#7C3AED">8 Pending approval</text>
      </g>

      <!-- Metric 3: Inventory Value -->
      <g transform="translate(364, 0)">
        <rect x="0" y="0" width="178" height="92" rx="12" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
        <text x="14" y="24" class="font-mono" font-size="10" font-weight="600" fill="#6B7280">Inventory Value</text>
        <text x="14" y="52" class="font-sans" font-size="19" font-weight="800" fill="#111827">$892,140.00</text>
        <text x="14" y="74" class="font-mono" font-size="9.5" fill="#6B7280">Raw lumber + stock</text>
      </g>
    </g>

    <!-- Active Artisan Production Orders Section -->
    <g transform="translate(24, 196)">
      <rect x="0" y="0" width="542" height="248" rx="14" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
      
      <!-- Section Title -->
      <text x="16" y="24" class="font-mono" font-size="10.5" font-weight="800" fill="#374151" letter-spacing="0.5">ACTIVE ARTISAN PRODUCTION ORDERS</text>
      <text x="526" y="24" class="font-mono" font-size="10" font-weight="700" fill="#7C3AED" text-anchor="end">View All Batches</text>

      <!-- Order Item 1: Aalto High Credenza -->
      <g transform="translate(16, 40)">
        <rect x="0" y="0" width="510" height="74" rx="10" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/>
        
        <!-- Icon -->
        <rect x="14" y="16" width="42" height="42" rx="8" fill="#F3E8FF"/>
        <path d="M 27 28 Q 27 24 35 24 Q 43 24 43 28 L 43 36 L 27 36 Z M 25 36 L 45 36 M 28 36 L 26 42 M 42 36 L 44 42" stroke="#7C3AED" stroke-width="1.8" stroke-linecap="round" fill="none"/>

        <!-- Details -->
        <text x="68" y="32" class="font-sans" font-size="13" font-weight="700" fill="#111827">Aalto High Credenza (Walnut &amp; Brass)</text>
        <text x="68" y="49" class="font-mono" font-size="10" fill="#6B7280">ORD-8491 • Studio Form &amp; Line</text>

        <!-- Price & Badges -->
        <text x="410" y="32" class="font-sans" font-size="13.5" font-weight="800" fill="#111827" text-anchor="end">$18,400.00</text>
        <text x="410" y="48" class="font-mono" font-size="9.5" font-weight="700" fill="#10B981" text-anchor="end">50% Settled</text>

        <rect x="424" y="25" width="72" height="24" rx="6" fill="#EDE9FE"/>
        <text x="460" y="41" class="font-mono" font-size="9" font-weight="700" fill="#7C3AED" text-anchor="middle">In Milling</text>
      </g>

      <!-- Order Item 2: Custom Bouclé Modular Sectional -->
      <g transform="translate(16, 126)">
        <rect x="0" y="0" width="510" height="74" rx="10" fill="#FFFFFF" stroke="#E5E7EB" stroke-width="1"/>
        
        <!-- Icon -->
        <rect x="14" y="16" width="42" height="42" rx="8" fill="#F3E8FF"/>
        <path d="M 25 32 Q 25 25 35 25 Q 45 25 45 32 L 45 38 L 25 38 Z M 23 38 L 47 38 M 27 38 L 25 43 M 43 38 L 45 43" stroke="#7C3AED" stroke-width="1.8" stroke-linecap="round" fill="none"/>

        <!-- Details -->
        <text x="68" y="32" class="font-sans" font-size="13" font-weight="700" fill="#111827">Custom Bouclé Modular Sectional</text>
        <text x="68" y="49" class="font-mono" font-size="10" fill="#6B7280">ORD-8489 • Nordic Timber Co.</text>

        <!-- Price & Badges -->
        <text x="410" y="32" class="font-sans" font-size="13.5" font-weight="800" fill="#111827" text-anchor="end">$24,800.00</text>
        <text x="410" y="48" class="font-mono" font-size="9.5" fill="#6B7280" text-anchor="end">Foam Reconciled</text>

        <rect x="424" y="25" width="72" height="24" rx="6" fill="#F3F4F6"/>
        <text x="460" y="41" class="font-mono" font-size="9" font-weight="700" fill="#4B5563" text-anchor="middle">Upholstery</text>
      </g>
    </g>
  </g>

  <!-- Bottom Sub-Banner -->
  <g transform="translate(120, 680)">
    <text x="480" y="20" class="font-mono" font-size="11" font-weight="700" fill="#9CA3AF" text-anchor="middle" letter-spacing="1">TRUSTED BY 450+ BESPOKE STUDIOS &amp; ATELIERS GLOBALLY</text>
  </g>
</svg>
